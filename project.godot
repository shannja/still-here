; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Still Here"
config/description="You play as a dead guide dog helping his blind owner through his final dementia episode. The world lies unless you bark to reveal the truth."
config/version="v1.0.0"
run/main_scene="uid://c4ty62qntnd4o"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0.62352943, 0.7411765, 1)
boot_splash/show_image=false
boot_splash/use_filter=false

[autoload]

Configurations="*uid://dlcfinr1a487o"
Settings="*uid://cj0j0qsq7hg3e"
States="*uid://bqwt8xneblxp"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/extend_to_title=true
window/size/window_width_override=1024
window/size/window_height_override=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

naming/node_name_num_separator=2
naming/node_name_casing=2
naming/script_name_casing=2

